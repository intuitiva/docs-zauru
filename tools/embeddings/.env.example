# Conexión. Si omites PGHOST, el cliente usa localhost.
# En Postgres.app el socket local está en /tmp (PGHOST=/tmp).
PGHOST=localhost
PGPORT=5432
PGUSER=finanzas
PGPASSWORD=

# Base que se crea si no existe, y base de mantenimiento para el CREATE DATABASE.
PGDATABASE=rag
PGADMIN_DATABASE=postgres

# Carpeta de markdown. Por defecto: <repo>/docs
# DOCS_PATH=/ruta/a/docs

# Servidor de embeddings: llamafile o lmstudio.
# Si EMBEDDING_URL está vacío, el import carga el texto y deja embedding en NULL.
# llamafile: POST {"content": "..."}
# lmstudio:  POST {"input": "..."}
EMBEDDING_SERVER=llamafile
EMBEDDING_URL=http://localhost:3005/embedding
#EMBEDDING_SERVER=lmstudio
#EMBEDDING_URL=http://127.0.0.1:1234/v1/embeddings
